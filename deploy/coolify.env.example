# Variáveis sugeridas no Coolify (Environment). Segredos: marque como Secret.
# O arquivo mailcow.conf no servidor é a fonte da verdade após o 1º deploy.
#
# O Coolify também lista POP_PORT, IMAP_PORT, SMTP_PORT, DBPASS, etc. porque
# estão no docker-compose.yml — NÃO apague essas linhas (dá erro). Ignore ou
# deixe o valor padrão; não é necessário repetir portas aqui.

MAILCOW_HOSTNAME=mail.sowtech.io
TZ=America/Sao_Paulo
COMPOSE_PROJECT_NAME=mailcowdockerized
DOCKER_COMPOSE_VERSION=native
SKIP_CLAMD=y
ENABLE_IPV6=true

# Opcional no 1º deploy (senão o script gera aleatório):
# DBPASS=
# DBROOT=
# REDISPASS=

# Mesma VPS que o Coolify (Traefik já usa 80/443): use portas alternativas + proxy reverso mailcow
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SKIP_LETS_ENCRYPT=y

COOLIFY_SYNC_HOSTNAME=y
COOLIFY_USE_EXAMPLE_CONF=n

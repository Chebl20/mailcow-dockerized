# Exemplo versionável — copie para mailcow.conf local ou use deploy/coolify-ensure-config.sh.
# NUNCA commite mailcow.conf com DBPASS/DBROOT/REDISPASS reais em repositório público.

MAILCOW_HOSTNAME=mail.sowtech.io
MAILCOW_PASS_SCHEME=BLF-CRYPT

DBNAME=mailcow
DBUSER=mailcow
DBPASS=SUBSTITUA_POR_SEGREDO_ALEATORIO_28_CHARS
DBROOT=SUBSTITUA_POR_SEGREDO_ALEATORIO_28_CHARS

REDISPASS=SUBSTITUA_POR_SEGREDO_ALEATORIO_28_CHARS

HTTP_PORT=80
HTTP_BIND=
HTTPS_PORT=443
HTTPS_BIND=
HTTP_REDIRECT=y

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEADM_PORT=127.0.0.1:19991
SQL_PORT=127.0.0.1:13306
REDIS_PORT=127.0.0.1:7654

TZ=America/Sao_Paulo
COMPOSE_PROJECT_NAME=mailcowdockerized
DOCKER_COMPOSE_VERSION=native

ACL_ANYONE=disallow
MAILDIR_GC_TIME=7200
ADDITIONAL_SAN=
AUTODISCOVER_SAN=y
ADDITIONAL_SERVER_NAMES=

SKIP_LETS_ENCRYPT=n
ACME_DNS_CHALLENGE=n
ENABLE_SSL_SNI=n
SKIP_UNBOUND_HEALTHCHECK=n
SKIP_CLAMD=y
SKIP_OLEFY=n
SKIP_SOGO=n
SKIP_FTS=n
USE_WATCHDOG=y

IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
ENABLE_IPV6=true
DISABLE_NETFILTER_ISOLATION_RULE=n

MAILDIR_SUB=Maildir
SOGO_EXPIRE_SESSION=480
SOGO_URL_ENCRYPTION_KEY=CHANGEME16CHARS01

DOVECOT_MASTER_USER=
DOVECOT_MASTER_PASS=
WEBAUTHN_ONLY_TRUSTED_VENDORS=n
SPAMHAUS_DQS_KEY=
